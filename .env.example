# PostgreSQL (Neon / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fragola?schema=public"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin login (simple env-based auth)
ADMIN_EMAIL="admin@fragolagelato.com"
